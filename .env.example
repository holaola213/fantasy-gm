POSTGRES_DB=fantasy_gm
POSTGRES_USER=fantasy_gm_user
POSTGRES_PASSWORD=fantasy_gm_password

# Docker-internal database URL used by the backend service.
DATABASE_URL=postgresql+asyncpg://fantasy_gm_user:fantasy_gm_password@db:5432/fantasy_gm

# Browser-facing URLs:
# - Frontend: http://localhost:5173
# - Backend: http://localhost:8000
# - Swagger: http://localhost:8000/docs

# Docker-internal backend URL used by the Vite dev proxy.
VITE_API_PROXY_TARGET=http://backend:8000
